    </div>
  </section>

  <section class="section" id="menu">
    <h2>The Fooder Kitchen Menu</h2>
    <p>Prepared daily with pure desi ghee and original Andhra spice blends.</p>
    <div class="menu-grid" id="menu-list"></div>
  </section>

  <section class="section" id="branches">
    <h2>Our 6 Branches</h2>
    <p>Serving Vijayawada • Guntur • Eluru • Machilipatnam • Tenali • Hyderabad</p>
  </section>

  <section class="section" id="reserve">
    <h2>Book a Table in Your City</h2>
    <div class="booking-box">
      <form onsubmit="bookTable(event)">
        <div class="form-grid">
          <input type="text" id="cust-name" placeholder="Full Name" required />
          <input type="tel" id="cust-phone" placeholder="10-Digit Mobile Number" required />
          <select id="branch">
            <option>Vijayawada (MG Road)</option>
            <option>Guntur (Brodipet)</option>
            <option>Eluru (Powerpet)</option>
            <option>Hyderabad (Jubilee Hills)</option>
          </select>
          <input type="date" required />
        </div>
        <button type="submit" class="btn-primary">Request Table Reservation</button>
      </form>
    </div>
  </section>

  <footer>
    <p>© 2026 The Fooder - Authentic Andhra Cuisine. Supabase Cloud PostgreSQL Ready.</p>
  </footer>

  <script>
    const dishes = [
      { name: "Andhra Veg Meals", desc: "Rice, pappu, gongura pachadi, curries, sambar, curd & ghee", price: 180 },
      { name: "Chicken Meals", desc: "Full meals with Andhra chicken fry and spicy gravy", price: 240 },
      { name: "Gongura Mutton", desc: "Slow-cooked mutton with sour gongura leaves", price: 360 },
      { name: "Gutti Vankaya Curry", desc: "Stuffed brinjal in peanut and sesame masala", price: 150 },
      { name: "Natu Kodi Pulusu", desc: "Country chicken stewed in tamarind gravy", price: 320 },
      { name: "Chicken Dum Biryani", desc: "Basmati cooked on dum, served with raita & salan", price: 260 },
      { name: "Pesarattu Upma", desc: "Green gram dosa filled with upma & ginger chutney", price: 90 },
      { name: "Pootharekulu", desc: "Paper-thin rice sheets layered with ghee and sugar", price: 120 }
    ];

    let cartCount = 0;
    let cartTotal = 0;

    const menuList = document.getElementById("menu-list");
    dishes.forEach(item => {
      menuList.innerHTML += `
        <div class="menu-item">
          <div>
            <h3>${item.name}</h3>
            <p>${item.desc}</p>
          </div>
          <div class="price-row">
            <span class="price">₹${item.price}</span>
            <button class="add-btn" onclick="addToCart('${item.name}', ${item.price})">+ ADD</button>
          </div>
        </div>
      `;
    });

    function addToCart(name, price) {
      cartCount++;
      cartTotal += price;
      document.getElementById("cart-count").innerText = cartCount;
      document.getElementById("cart-total").innerText = cartTotal;
      if (cartTotal >= 500) {
        alert(name + " added! 🎉 You unlocked a FREE Bobbatlu sweet!");
      }
    }

    function viewCart() {
      alert("Items in Cart: " + cartCount + "\nTotal Amount: ₹" + cartTotal + (cartTotal >= 500 ? "\n🎁 Free Bobbatlu Included!" : ""));
    }

    function bookTable(e) {
      e.preventDefault();
      const name = document.getElementById("cust-name").value;
      const branch = document.getElementById("branch").value;
      alert("Thank you " + name + "! Your table reservation request at " + branch + " is confirmed.");
    }
  </script>
</body>
