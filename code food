      { name: "Pootharekulu", desc: "Paper-thin rice sheets layered with ghee and sugar", price: 120 }
    ];

    let cartCount = 0;
    let cartTotal = 0;

    const menuList = document.getElementById("menu-list");
    dishes.forEach(item => {
      menuList.innerHTML += `
        <div class="menu-item">
          <div>
            <h3>${item.name}</h3>
            <p>${item.desc}</p>
          </div>
          <div class="price-row">
            <span class="price">₹${item.price}</span>
